# GEMINI_API_KEY: Required for Gemini AI API calls (SERVER-SIDE ONLY).
# This secret must NEVER be exposed to the client/browser.
# Configure this in your server environment (Netlify Functions, Cloud Run, etc.)
# Do NOT prefix with VITE_ - that would expose it to the frontend bundle.
GEMINI_API_KEY="your-gemini-api-key"
# Optional model override. The default is gemini-3.6-flash.
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.

# Supabase configuration (client-safe: publishable/anon key only)
# The publishable key is meant to be public for client-side Supabase access.
# NEVER use the Supabase SERVICE_ROLE key in frontend code.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
